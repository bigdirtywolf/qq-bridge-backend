# 后端监听端口
PORT=4000

# ── SnowLuma / OneBot ─────────────────────────────────────────────────────────
# 全部留空即可：会自动从 SnowLuma 的 config/onebot_<QQ号>.json 里发现端点与令牌。
# SNOWLUMA_HOME=D:\SnowLuma
# SNOWLUMA_HTTP_URL=http://127.0.0.1:3000
# SNOWLUMA_WS_URL=ws://127.0.0.1:3001
SNOWLUMA_TOKEN=mySnowLumaToken_
SNOWLUMA_WS_TOKEN=mySnowLumaToken_

# ── DSH (DeepSeek Harness) ────────────────────────────────────────────────────
# 全部留空即可：会自动识别端口（桌面版随机端口 / CLI 3080），并用本地持久化密钥离线铸造 Cookie。
# DSH_HOME=C:\Users\Administrator\.dsh
# DSH_BASE_URL=
# DSH_AUTH_TOKEN=
